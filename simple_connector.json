{
  "name": "simple-jdbc-sink-yb",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "simple.TEST_ORDERS",
    "connection.url": "jdbc:yugabytedb://yugabyte:5433/yugabyte?load-balance=false",
    "connection.user": "yugabyte",
    "connection.password": "yugabyte",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "id",
    "table.name.format": "test_orders",
    "auto.create": "false",
    "auto.evolve": "false",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}